# Root .gitignore for KOPANJO

# Backend (Laravel)
backend/.env
backend/.env.backup
backend/.env.production
backend/vendor/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/pail/
backend/.phpunit.cache
backend/.phpunit.result.cache

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*.local

# General
.env
.env.*
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

