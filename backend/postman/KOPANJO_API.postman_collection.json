{
  "info": {
    "_postman_id": "kopanjo-backend-api-v1",
    "name": "KOPANJO RESTful API",
    "description": "Dokumentasi dan Pengujian API untuk KOPANJO (Kolaborasi Pengelolaan Administrasi dan Organisasi) - Laravel 12 Backend",
